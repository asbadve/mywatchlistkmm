CREATE TABLE releaseReminder (
    mediaId INTEGER NOT NULL,
    mediaType TEXT NOT NULL,
    seasonNumber INTEGER NOT NULL DEFAULT -1,
    episodeNumber INTEGER NOT NULL DEFAULT -1,
    title TEXT NOT NULL,
    posterPath TEXT,
    releaseDate TEXT NOT NULL,
    releaseSource TEXT,
    addedAt INTEGER NOT NULL,
    lastCheckedAt INTEGER,
    PRIMARY KEY (mediaId, mediaType, seasonNumber, episodeNumber)
);

CREATE TABLE reminderPreference (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    enabled INTEGER NOT NULL DEFAULT 1,
    minutesOfDay INTEGER NOT NULL DEFAULT 540
);
