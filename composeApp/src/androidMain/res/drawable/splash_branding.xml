<?xml version="1.0" encoding="utf-8"?>
<!-- Wraps splash_branding.png (drawable-xhdpi) so the platform's SplashScreenView renders it at
     its own aspect ratio, centered, instead of stretching it to fill the branding slot's full
     width - the default behavior when windowSplashScreenBrandingImage points straight at a raster
     drawable with no gravity/scale hint. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/splash_branding_asset"
    android:gravity="center" />
